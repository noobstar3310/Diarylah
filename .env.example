# Copy to .env.local and fill in. Never commit .env.local — .gitignore excludes it.
#
# PASSWORD ENCODING: if your Supabase database password contains any of these
# characters, percent-encode them in both URLs below or the connection will fail
# with a misleading error:
#   @ -> %40   # -> %23   / -> %2F   ? -> %3F
#   : -> %3A   & -> %26   + -> %2B   space -> %20

# --- Database (Prisma) ---------------------------------------------------
# Supabase dashboard: Settings -> Database -> Connection string
#
# DATABASE_URL uses the TRANSACTION POOLER (port 6543). Required for serverless
# runtimes, which would otherwise exhaust Postgres connections.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL uses the DIRECT connection (port 5432). Used only by Prisma Migrate,
# which cannot run DDL through a transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase (auth + storage only) --------------------------------------
# Supabase dashboard: Settings -> API
# The Data API is disabled on this project by design; supabase-js is used only
# for Auth and Storage. All table access goes through Prisma.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# The "publishable" key (sb_publishable_...). Safe to expose in the browser: with
# the Data API disabled it can only reach Auth and Storage, never tables.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# SERVER-ONLY. The "secret" key (sb_secret_...). Full database bypass — never
# import this into a Client Component and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# --- Web Push (Phase 4, not needed yet) ----------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
